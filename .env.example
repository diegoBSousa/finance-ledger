COMPOSE_PROJECT_NAME=finance-ledger
LOCAL_UID=1000
LOCAL_GID=1000
API_PORT=8080
FRONTEND_PORT=5173

APP_NAME="Finance Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=finance_ledger
DB_USERNAME=ledger
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=finance_ledger:
CACHE_STORE=redis
CACHE_PREFIX=finance_ledger_cache:
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90
SESSION_DRIVER=array
HASH_DRIVER=argon2id
FILESYSTEM_DISK=local
MAIL_MAILER=log

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
